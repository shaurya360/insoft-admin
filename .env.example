# Copy to .env and fill in.  Then run:  npm run dev
#
# Supabase Dashboard → Project Settings → API (or "API Keys")
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# The anon / publishable key. It is designed to be public — RLS protects the data.
# NEVER put the service_role / secret key here (the build refuses it).
SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
