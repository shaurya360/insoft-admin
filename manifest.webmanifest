{
  "name": "INSOFT Admin",
  "short_name": "INSOFT",
  "description": "Quotations, vendors, clients and money manager for Insoft Technology.",
  "id": "./dashboard.html",
  "start_url": "./dashboard.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#0b57b7",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New quotation", "url": "./quotation.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Vendors", "url": "./vendors.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Website enquiries", "url": "./enquiries.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
